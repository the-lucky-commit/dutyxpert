ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
# cPanel example: /home/dutyxcnk/dutyxpert-data
# Vercel example: /tmp/dutyxpert-data (ephemeral)
DUTYXPERT_DATA_DIR=/absolute/path/outside-the-application-directory

# Optional SMTP notification for contact submissions
SMTP_HOST=mail.dutyxpert.com
SMTP_PORT=465
SMTP_USER=info@dutyxpert.com
SMTP_PASSWORD=replace-with-mailbox-password
CONTACT_RECIPIENT=info@dutyxpert.com
